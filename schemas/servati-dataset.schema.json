{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:servati:schema:dataset:2",
  "title": "SERVATI structured lore dataset",
  "description": "OnlyWorlds-derived entity vocabulary with SERVATI canon, provenance, relative chronology, preservation-problem, and science controls.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "canon_status", "schema_basis", "working_pack", "world_reference", "entries"],
  "properties": {
    "$schema": {"type": "string"},
    "dataset_id": {"type": "string", "pattern": "^SV-[A-Z0-9-]+$"},
    "canon_status": {"$ref": "#/definitions/canonStatus"},
    "schema_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "revision", "licence", "scope"],
      "properties": {
        "project": {"const": "OnlyWorlds/OnlyWorlds"},
        "revision": {"const": "ed84fa19c15c5bfb18019245faacdbdcb7cd9e0f"},
        "licence": {"const": "MIT"},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "working_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "world_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Id", "status", "note"],
      "properties": {
        "Id": {"$ref": "#/definitions/uuidV7"},
        "status": {"const": "DRAFT_PLACEHOLDER"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/entry"}
    }
  },
  "definitions": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "idArray": {
      "type": "array",
      "items": {"$ref": "#/definitions/uuidV7"},
      "uniqueItems": true
    },
    "canonStatus": {
      "enum": ["CORE", "RECORDED", "RECONSTRUCTED", "DISPUTED", "DOCTRINAL", "APOCRYPHAL", "DRAFT"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_ref", "verification", "note"],
      "properties": {
        "source_kind": {
          "enum": ["released-manuscript", "repository-baseline", "recovered-record", "archaeological-fragment", "doctrinal-source", "editorial-reconstruction", "generated-candidate", "research-source", "working-pack"]
        },
        "source_ref": {"type": "string", "minLength": 1},
        "source_location": {"type": ["string", "null"]},
        "verification": {"enum": ["VERIFIED", "SOURCE-UNAVAILABLE", "PENDING-REVIEW", "NOT-APPLICABLE"]},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "relativeSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_label", "position", "confidence", "basis"],
      "properties": {
        "sequence_label": {"type": "string", "minLength": 1},
        "position": {"type": "integer", "minimum": 1},
        "confidence": {"enum": ["proposed", "relative-supported", "unknown"]},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "scienceReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "review_note"],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "status", "basis"],
            "properties": {
              "claim": {"type": "string", "minLength": 1},
              "status": {"enum": ["verified", "plausible", "speculative", "unresolved", "requires-review"]},
              "basis": {"type": "string", "minLength": 1}
            }
          }
        },
        "review_note": {"type": "string", "minLength": 1}
      }
    },
    "servatiMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["servati_id", "canon_status", "era", "inheritance_logic", "provenance", "science_status", "preservation_problem", "editorial_notes"],
      "properties": {
        "servati_id": {"type": "string", "pattern": "^SV-[A-Z0-9-]+$"},
        "canon_status": {"$ref": "#/definitions/canonStatus"},
        "era": {"type": ["string", "null"]},
        "chronology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "unit", "dating_system", "precision"],
          "properties": {
            "start": {"type": ["integer", "string", "null"]},
            "end": {"type": ["integer", "string", "null"]},
            "unit": {"type": ["string", "null"]},
            "dating_system": {"type": ["string", "null"]},
            "precision": {"enum": ["exact", "bounded", "approximate", "order-of-magnitude", "unknown"]}
          }
        },
        "relative_sequence": {"$ref": "#/definitions/relativeSequence"},
        "inheritance_logic": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["Remains", "Memory", "Seed", "Ritual", "Structure", "Pattern", "Mixed", "None"]}
        },
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/provenance"}},
        "science_status": {"enum": ["verified", "plausible", "speculative", "unresolved", "requires-review", "not-applicable"]},
        "science_review": {"$ref": "#/definitions/scienceReview"},
        "preservation_problem": {"type": "string", "minLength": 1},
        "contradictions": {"type": "array", "items": {"type": "string"}},
        "first_appearance": {"type": ["string", "null"]},
        "editorial_notes": {"type": "string", "minLength": 1}
      }
    },
    "Setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "function"],
      "properties": {
        "form": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1},
        "parent_location": {"$ref": "#/definitions/uuidV7"},
        "populations": {"$ref": "#/definitions/idArray"}
      }
    },
    "Politics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "political_climate": {"type": "string", "minLength": 1},
        "primary_power": {"$ref": "#/definitions/uuidV7"},
        "secondary_powers": {"$ref": "#/definitions/idArray"},
        "rival": {"$ref": "#/definitions/uuidV7"},
        "partner": {"$ref": "#/definitions/uuidV7"}
      }
    },
    "Construction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architecture": {"type": "string", "minLength": 1},
        "buildings": {"$ref": "#/definitions/idArray"}
      }
    },
    "Formation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition"],
      "properties": {
        "composition": {"type": "string", "minLength": 1},
        "operator": {"$ref": "#/definitions/uuidV7"},
        "equipment": {"$ref": "#/definitions/idArray"}
      }
    },
    "Dynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity", "state"],
      "properties": {
        "activity": {"type": "string", "minLength": 1},
        "disposition": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1}
      }
    },
    "Foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doctrine"],
      "properties": {
        "doctrine": {"type": "string", "minLength": 1},
        "parent_institution": {"$ref": "#/definitions/uuidV7"}
      }
    },
    "Claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"objects": {"$ref": "#/definitions/idArray"}}
    },
    "Form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aesthetics"],
      "properties": {
        "aesthetics": {"type": "string", "minLength": 1},
        "parent_object": {"$ref": "#/definitions/uuidV7"}
      }
    },
    "Function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utility"],
      "properties": {"utility": {"type": "string", "minLength": 1}}
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["story", "consequences"],
      "properties": {
        "story": {"type": "string", "minLength": 1},
        "consequences": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "parent_narrative": {"$ref": "#/definitions/uuidV7"},
        "conservator": {"$ref": "#/definitions/uuidV7"}
      }
    },
    "Structure": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "phonology": {"type": "string", "minLength": 1},
        "grammar": {"type": "string", "minLength": 1},
        "lexicon": {"type": "string", "minLength": 1},
        "writing": {"type": "string", "minLength": 1}
      }
    },
    "Biology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appearance"],
      "properties": {"appearance": {"type": "string", "minLength": 1}}
    },
    "Psychology": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "instincts": {"type": "string", "minLength": 1},
        "sociality": {"type": "string", "minLength": 1},
        "temperament": {"type": "string", "minLength": 1},
        "communication": {"type": "string", "minLength": 1}
      }
    },
    "Nature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "history": {"type": "string", "minLength": 1},
        "challenges": {"type": "string", "minLength": 1},
        "consequences": {"type": "string", "minLength": 1},
        "background": {"type": "string", "minLength": 1},
        "triggers": {"$ref": "#/definitions/idArray"},
        "events": {"$ref": "#/definitions/idArray"}
      }
    },
    "Involves": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "events": {"$ref": "#/definitions/idArray"},
        "objects": {"$ref": "#/definitions/idArray"},
        "locations": {"$ref": "#/definitions/idArray"},
        "species": {"$ref": "#/definitions/idArray"},
        "institutions": {"$ref": "#/definitions/idArray"},
        "collectives": {"$ref": "#/definitions/idArray"},
        "languages": {"$ref": "#/definitions/idArray"},
        "relations": {"$ref": "#/definitions/idArray"},
        "narratives": {"$ref": "#/definitions/idArray"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Id", "Name", "Description", "World", "Supertype", "Subtype", "servati"],
      "properties": {
        "Id": {"$ref": "#/definitions/uuidV7"},
        "Name": {"type": "string", "minLength": 1},
        "Description": {"type": "string", "minLength": 1},
        "World": {"$ref": "#/definitions/uuidV7"},
        "Supertype": {"enum": ["Location", "Event", "Collective", "Institution", "Object", "Narrative", "Language", "Species", "Relation"]},
        "Subtype": {"type": "string", "minLength": 1},
        "Setting": {"$ref": "#/definitions/Setting"},
        "Politics": {"$ref": "#/definitions/Politics"},
        "Construction": {"$ref": "#/definitions/Construction"},
        "Formation": {"$ref": "#/definitions/Formation"},
        "Dynamics": {"$ref": "#/definitions/Dynamics"},
        "Foundation": {"$ref": "#/definitions/Foundation"},
        "Claims": {"$ref": "#/definitions/Claims"},
        "Form": {"$ref": "#/definitions/Form"},
        "Function": {"$ref": "#/definitions/Function"},
        "Context": {"$ref": "#/definitions/Context"},
        "Structure": {"$ref": "#/definitions/Structure"},
        "Biology": {"$ref": "#/definitions/Biology"},
        "Psychology": {"$ref": "#/definitions/Psychology"},
        "Nature": {"$ref": "#/definitions/Nature"},
        "Involves": {"$ref": "#/definitions/Involves"},
        "servati": {"$ref": "#/definitions/servatiMetadata"}
      },
      "allOf": [
        {"if": {"properties": {"Supertype": {"const": "Location"}}}, "then": {"required": ["Setting"]}},
        {"if": {"properties": {"Supertype": {"const": "Event"}}}, "then": {"required": ["Nature", "Involves"], "properties": {"Nature": {"required": ["history", "consequences"]}}}},
        {"if": {"properties": {"Supertype": {"const": "Collective"}}}, "then": {"required": ["Formation", "Dynamics"]}},
        {"if": {"properties": {"Supertype": {"const": "Institution"}}}, "then": {"required": ["Foundation"]}},
        {"if": {"properties": {"Supertype": {"const": "Object"}}}, "then": {"required": ["Form", "Function"]}},
        {"if": {"properties": {"Supertype": {"const": "Narrative"}}}, "then": {"required": ["Context", "Involves"]}},
        {"if": {"properties": {"Supertype": {"const": "Language"}}}, "then": {"required": ["Structure"]}},
        {"if": {"properties": {"Supertype": {"const": "Species"}}}, "then": {"required": ["Biology"]}},
        {"if": {"properties": {"Supertype": {"const": "Relation"}}}, "then": {"required": ["Nature", "Involves"], "properties": {"Nature": {"required": ["background"]}}}}
      ]
    }
  }
}
