{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:servati:schema:dataset:1",
  "title": "SERVATI structured lore dataset",
  "description": "OnlyWorlds-derived entity vocabulary with SERVATI canon, provenance, chronology, and science controls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "canon_status",
    "schema_basis",
    "working_pack",
    "world_reference",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^SV-[A-Z0-9-]+$"
    },
    "canon_status": {
      "enum": [
        "CORE",
        "RECORDED",
        "RECONSTRUCTED",
        "DISPUTED",
        "DOCTRINAL",
        "APOCRYPHAL",
        "DRAFT"
      ]
    },
    "schema_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "revision", "licence", "scope"],
      "properties": {
        "project": {"const": "OnlyWorlds/OnlyWorlds"},
        "revision": {
          "const": "ed84fa19c15c5bfb18019245faacdbdcb7cd9e0f"
        },
        "licence": {"const": "MIT"},
        "scope": {"type": "string"}
      }
    },
    "working_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {"type": "string"},
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "world_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Id", "status", "note"],
      "properties": {
        "Id": {"$ref": "#/definitions/uuidV7"},
        "status": {"const": "DRAFT_PLACEHOLDER"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/entry"}
    }
  },
  "definitions": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_ref",
        "verification",
        "note"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "released-manuscript",
            "repository-baseline",
            "recovered-record",
            "archaeological-fragment",
            "doctrinal-source",
            "editorial-reconstruction",
            "generated-candidate",
            "research-source",
            "working-pack"
          ]
        },
        "source_ref": {"type": "string", "minLength": 1},
        "source_location": {"type": ["string", "null"]},
        "verification": {
          "enum": [
            "VERIFIED",
            "SOURCE-UNAVAILABLE",
            "PENDING-REVIEW",
            "NOT-APPLICABLE"
          ]
        },
        "note": {"type": "string", "minLength": 1}
      }
    },
    "servatiMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "servati_id",
        "canon_status",
        "era",
        "inheritance_logic",
        "provenance",
        "science_status",
        "editorial_notes"
      ],
      "properties": {
        "servati_id": {
          "type": "string",
          "pattern": "^SV-[A-Z0-9-]+$"
        },
        "canon_status": {
          "enum": [
            "CORE",
            "RECORDED",
            "RECONSTRUCTED",
            "DISPUTED",
            "DOCTRINAL",
            "APOCRYPHAL",
            "DRAFT"
          ]
        },
        "era": {"type": ["string", "null"]},
        "chronology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "unit", "dating_system", "precision"],
          "properties": {
            "start": {"type": ["integer", "string", "null"]},
            "end": {"type": ["integer", "string", "null"]},
            "unit": {"type": ["string", "null"]},
            "dating_system": {"type": ["string", "null"]},
            "precision": {
              "enum": [
                "exact",
                "bounded",
                "approximate",
                "order-of-magnitude",
                "unknown"
              ]
            }
          }
        },
        "inheritance_logic": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "Remains",
              "Memory",
              "Seed",
              "Ritual",
              "Structure",
              "Pattern",
              "Mixed",
              "None"
            ]
          }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/provenance"}
        },
        "science_status": {
          "enum": [
            "verified",
            "plausible",
            "speculative",
            "unresolved",
            "requires-review",
            "not-applicable"
          ]
        },
        "contradictions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "first_appearance": {"type": ["string", "null"]},
        "editorial_notes": {"type": "string", "minLength": 1}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Id",
        "Name",
        "Description",
        "World",
        "Supertype",
        "Subtype",
        "servati"
      ],
      "properties": {
        "Id": {"$ref": "#/definitions/uuidV7"},
        "Name": {"type": "string", "minLength": 1},
        "Description": {"type": "string", "minLength": 1},
        "World": {"$ref": "#/definitions/uuidV7"},
        "Supertype": {"enum": ["Location", "Event"]},
        "Subtype": {"type": "string", "minLength": 1},
        "Nature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["history", "consequences"],
          "properties": {
            "history": {"type": "string", "minLength": 1},
            "challenges": {"type": "string"},
            "consequences": {"type": "string", "minLength": 1},
            "start_date": {"type": "integer"},
            "end_date": {"type": "integer"},
            "triggers": {
              "type": "array",
              "items": {"$ref": "#/definitions/uuidV7"},
              "uniqueItems": true
            }
          }
        },
        "Involves": {
          "type": "object",
          "additionalProperties": false,
          "required": ["locations"],
          "properties": {
            "locations": {
              "type": "array",
              "items": {"$ref": "#/definitions/uuidV7"},
              "uniqueItems": true
            }
          }
        },
        "servati": {"$ref": "#/definitions/servatiMetadata"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"Supertype": {"const": "Event"}}
          },
          "then": {"required": ["Nature", "Involves"]}
        }
      ]
    }
  }
}
